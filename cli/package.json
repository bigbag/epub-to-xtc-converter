{
  "name": "epub-to-xtc",
  "version": "1.0.0",
  "description": "CLI tool for converting EPUB files to XTC/XTCH format for Xteink e-readers",
  "main": "index.js",
  "bin": {
    "epub-to-xtc": "./index.js"
  },
  "scripts": {
    "start": "node index.js",
    "test": "node --test pdf-core.test.js pdf-convert.test.js encoder.test.js stable-pages.test.js",
    "test:stable-pages": "node --test stable-pages.test.js",
    "test:pdf": "node --test pdf-core.test.js pdf-convert.test.js encoder.test.js"
  },
  "keywords": [
    "epub",
    "xtc",
    "xtch",
    "xteink",
    "e-reader",
    "converter"
  ],
  "license": "MIT",
  "dependencies": {
    "@napi-rs/canvas": "^1.2.1",
    "@xmldom/xmldom": "^0.8.15",
    "commander": "^12.0.0",
    "jszip": "^3.10.1",
    "minimatch": "^10.0.1",
    "pdfjs-dist": "6.5.438",
    "sharp": "^0.33.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
